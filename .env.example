# ============================================================
#  环境变量示例
#  使用方法：复制本文件为 .env，按需修改后填入实际值
#  ⚠️ 真实的 .env 已被 .gitignore 忽略，切勿提交到代码库
# ============================================================

# ---- 运行环境 ----
# production 会启用更严格的校验（如强制要求 JWT_SECRET）
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ---- 安全 ----
# JWT 签名密钥：生产环境必须提供，且不少于 32 位
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 访问令牌有效期（秒）
ACCESS_TOKEN_TTL_SEC=7200
ADMIN_TOKEN_TTL_SEC=28800

# ---- 初始管理员 ----
# 不设置 ADMIN_PASSWORD 时，首次启动会随机生成一个密码并打印在启动日志中
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 设为 1 可在下次启动时强制重置管理员密码为上面的 ADMIN_PASSWORD
RESET_ADMIN_PASSWORD=0

# ---- 数据存储 ----
# 留空则使用项目内的 ./data 目录
DATA_DIR=

# ---- 安全策略 ----
MAX_LOGIN_ATTEMPTS=8
LOGIN_WINDOW_MS=300000
JSON_BODY_LIMIT=256kb

# ---- CORS ----
# 同一域名下访问无需配置；跨域调试时填写允许的来源，逗号分隔
# 示例：http://localhost:5173,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=

# ---- 日志 ----
# debug | info | warn | error
LOG_LEVEL=info

# ---- GitHub 仓库同步（后台「推送仓库」按钮）----
# 令牌未填时服务照常运行，只是推送接口会返回配置指引。
# 生成 Fine-grained PAT：GitHub → 头像 → Settings → Developer settings
#                        → Personal access tokens → Fine-grained tokens
#   必须勾选：Repository permissions → Contents: Read and write
#   自动建仓库还需：Account permissions → Administration: Read and write
#   想用接口开关 GitHub Pages 还需：Repository permissions → Pages: Read and write
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=nurse-registry
GITHUB_BRANCH=main
# 置 1 时对身份证号打码（保留前 4 位与后 4 位）。
# 仓库公开时必须保持 1 —— 否则输密码后能看到完整号码。
GITHUB_MASK_IDENTITY=1

# ---- 受保护信息站点（内容加密后发布到 GitHub Pages）----
# code     —— 文件名用账号 id 派生的 10 位短码，不含任何敏感信息（默认，推荐）；
# idnumber —— 文件名用账号名（本系统即身份证号）。⚠️ 仓库公开后文件名本身
#             会把这些号码写在仓库文件列表里，对全网可见，切勿启用。
PUBLIC_PAGE_SLUG=code
# Pages 站点根地址；留空则按 GITHUB_OWNER/GITHUB_REPO 自动推导
PAGES_BASE_URL=
